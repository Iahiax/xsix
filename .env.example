# Copy the required names into Replit Secrets / Hugging Face Space Secrets.
# This file intentionally contains placeholders only. Do not put credentials here.

# Project-owned model hosted in a private Hugging Face Space
LOCAL_MODEL_URL=https://YOUR_USER-YOUR_SPACE.hf.space
LOCAL_MODEL_ID=YOUR_USER/YOUR_PRIVATE_MODEL
LOCAL_MODEL_API_TOKEN=configure_in_replit_secrets
LOCAL_MODEL_HF_TOKEN=configure_in_replit_secrets

# Hugging Face Space secrets (set in the Space settings, not in this app's .env)
SPACE_API_TOKEN=configure_in_huggingface_space_secrets
HF_READ_TOKEN=configure_in_huggingface_space_secrets
HF_WRITE_TOKEN=configure_in_huggingface_space_secrets
PROJECT_MODEL_ID=YOUR_USER/YOUR_PRIVATE_MODEL
FEEDBACK_DATASET_ID=YOUR_USER/YOUR_PRIVATE_DATASET
CANDIDATE_MODEL_REPO_PREFIX=YOUR_USER/YOUR_PRIVATE_CANDIDATE_PREFIX
BASE_MODEL_ID=Qwen/Qwen3-8B

# Read-only market / macro-data providers
FINNHUB_API_KEY=configure_in_replit_secrets
FMP_API_KEY=configure_in_replit_secrets
FRED_API_KEY=configure_in_replit_secrets

# Capital.com data and demo-only order gate. Configure these in Hugging Face Space
# Secrets for the Python quant lab; live API mode is not supported by this app.
CAPITAL_API_MODE=demo
CAPITAL_API_KEY=configure_in_huggingface_space_secrets
CAPITAL_IDENTIFIER=configure_in_huggingface_space_secrets
CAPITAL_PASSWORD=configure_in_huggingface_space_secrets
CAPITAL_DEMO_EXECUTION_ENABLED=false
CAPITAL_DEMO_OPERATOR_USERNAMES=your_huggingface_username
CAPITAL_DEMO_MAX_ORDER_SIZE=0.01
QUANT_SQLITE_PATH=quant_data/market_research.sqlite3

# Telegram notifications (keep bot commands non-executing)
TELEGRAM_BOT_TOKEN=configure_in_replit_secrets
TELEGRAM_CHAT_ID=configure_in_replit_secrets
